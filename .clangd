CompileFlags:
  # Points clangd at the Conan build tree, which removes the need for a
  # compile_commands.json symlink at the repository root. Change the suffix if
  # you work in a different configuration.
  CompilationDatabase: ./build/RelWithDebInfo

Diagnostics:
  UnusedIncludes: Strict
  # MissingIncludes stays off. It reports every std and glm name that arrives
  # through a transitive include, which buries the findings that matter.
  MissingIncludes: None

---
# Macro-only headers. A file includes these for ENGINE_LOG_*, ENGINE_ASSERT,
# ENGINE_CHECK, and the Tracy wrappers. clangd cannot always see a macro as a
# use, so it reports the include as unused when it is not.
If:
  PathMatch: '.*src/core/(log|assert|profile)\.h'
Diagnostics:
  UnusedIncludes: None

---
# vk_common.h includes <cstdint> for the std::int32_t cast inside ENGINE_VK_TRY.
# clangd does not expand the macro, so it calls the include unused. Every file
# that uses the macro needs the include, so it stays.
If:
  PathMatch: '.*src/gfx/vulkan/vk_common\.h'
Diagnostics:
  UnusedIncludes: None

---
# Generated by CMake from src/core/version.h.in. It does not exist until the
# first configure, so do not report on it.
If:
  PathMatch: '.*src/core/version\.h'
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None
