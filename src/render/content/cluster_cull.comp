#version 450

// Divides the frustum into tiles and depth slices, and writes a short list of
// light indices for each cell. mesh.frag then reads the list for the cell the
// fragment is in, which gives each pixel far fewer lights to loop over.
//
// One work item for each cell, so the dispatch size is the cell count and each
// thread works alone. The thread tests every point light against its cell and
// writes the ones that intersect. Directional lights go in every cell because
// they have no position to test against.

// Must match kClusterTileCountX and friends in mesh_pass.h.
const uint kTileCountX = 16u;
const uint kTileCountY = 12u;
const uint kSliceCount = 16u;
const uint kMaxLightsPerCell = 64u;

// The near plane the projection was built with, and the furthest distance the
// cluster grid reaches. Exponential slices between them give far more slices
// near the camera, where geometry is dense, and far fewer in the distance.
// Must match mesh.frag and the call site of perspective_reverse_z.
const float kZNear = 0.1;
const float kClusterFar = 100.0;

const uint kCellCount = kTileCountX * kTileCountY * kSliceCount;

// The light list the CPU uploaded. Must match GpuLight in mesh_pass.h.
struct Light {
    vec4 position; // xyz, w=0 for directional and w=1 for point
    vec4 color;    // rgb = color * intensity, a = range
};

layout(set = 0, binding = 0) uniform ClusterParams {
    mat4 inv_view_projection;
    uvec4 grid_info; // x = light count, yzw = unused
} params;

layout(set = 0, binding = 1) readonly buffer Lights {
    Light lights[];
} light_buffer;

// Each cell: a count and up to kMaxLightsPerCell light indices, stored flat.
// cells[cell] is the count, and cells[kCellCount + cell * kMaxLightsPerCell + idx]
// is the idx-th light index for that cell.
layout(set = 0, binding = 2) buffer ClusterGrid {
    uint cells[];
} grid;

// Whether a sphere overlaps an axis-aligned bounding box.
bool sphere_overlaps_aabb(vec3 center, float radius, vec3 bmin, vec3 bmax) {
    float sq_dist = 0.0;
    for (int i = 0; i < 3; ++i) {
        float v = center[i];
        if (v < bmin[i]) {
            sq_dist += (bmin[i] - v) * (bmin[i] - v);
        } else if (v > bmax[i]) {
            sq_dist += (v - bmax[i]) * (v - bmax[i]);
        }
    }
    return sq_dist <= radius * radius;
}

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
void main() {
    uint cell = gl_GlobalInvocationID.x;
    if (cell >= kCellCount) {
        return;
    }

    uint tile_x = cell % kTileCountX;
    uint tile_y = (cell / kTileCountX) % kTileCountY;
    uint slice = cell / (kTileCountX * kTileCountY);

    // NDC bounds for this cell. Vulkan NDC: x in [-1,1], y in [-1,1], z in [0,1].
    // Reverse-Z: z=1 at near, z=0 at far.
    float ndc_min_x = (2.0 * float(tile_x) / float(kTileCountX)) - 1.0;
    float ndc_max_x = (2.0 * float(tile_x + 1u) / float(kTileCountX)) - 1.0;
    float ndc_min_y = (2.0 * float(tile_y) / float(kTileCountY)) - 1.0;
    float ndc_max_y = (2.0 * float(tile_y + 1u) / float(kTileCountY)) - 1.0;

    // Exponential slices in view distance, between kZNear and kClusterFar.
    // NDC depth follows reverse-Z: z = kZNear / d for distance d.
    float log_factor = log(kClusterFar / kZNear);
    float slice_near = kZNear * exp(float(slice) / float(kSliceCount) * log_factor);
    float slice_far  = kZNear * exp(float(slice + 1u) / float(kSliceCount) * log_factor);
    float ndc_min_z = kZNear / slice_far;  // far end, smaller NDC z
    float ndc_max_z = kZNear / slice_near; // near end, larger NDC z, clamped to 1

    // Unproject the 8 corners to world space and take the AABB.
    vec3 corners[8];
    for (uint i = 0u; i < 8u; ++i) {
        float x = (i & 1u) != 0u ? ndc_max_x : ndc_min_x;
        float y = (i & 2u) != 0u ? ndc_max_y : ndc_min_y;
        float z = (i & 4u) != 0u ? ndc_max_z : ndc_min_z;
        vec4 world = params.inv_view_projection * vec4(x, y, z, 1.0);
        corners[i] = world.xyz / world.w;
    }

    vec3 aabb_min = corners[0];
    vec3 aabb_max = corners[0];
    for (uint i = 1u; i < 8u; ++i) {
        aabb_min = min(aabb_min, corners[i]);
        aabb_max = max(aabb_max, corners[i]);
    }

    // Write light indices for this cell.
    uint output_count = 0u;
    uint base_index = kCellCount + cell * kMaxLightsPerCell;

    // Directional lights go in every cell because they have no position to
    // test. They go in first, so a cell crowded with point lights never drops
    // the key light and the shadow it casts.
    for (uint i = 0u; i < params.grid_info.x && output_count < kMaxLightsPerCell; ++i) {
        if (light_buffer.lights[i].position.w < 0.5) {
            grid.cells[base_index + output_count] = i;
            ++output_count;
        }
    }

    // Then the point lights whose range sphere reaches this cell.
    for (uint i = 0u; i < params.grid_info.x && output_count < kMaxLightsPerCell; ++i) {
        Light l = light_buffer.lights[i];
        if (l.position.w < 0.5) {
            continue;
        }
        float range = max(l.color.a, 1e-4);
        if (sphere_overlaps_aabb(l.position.xyz, range, aabb_min, aabb_max)) {
            grid.cells[base_index + output_count] = i;
            ++output_count;
        }
    }

    grid.cells[cell] = output_count;
}
